# Copiar a `.env` / `.env.local` y completar. NUNCA commitear archivos con valores reales
# (ver pendiente post-pruebas en docs/CHANGELOG.md).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend real (solo servidor; usado por los rewrites dev de next.config.js).
# En producción Traefik sirve todos los /ms-* en el mismo host.
AUTH_API_ORIGIN=http://localhost:8081
USERS_API_ORIGIN=http://localhost:8082
COMPANIES_API_ORIGIN=http://localhost:8083
PRODUCTS_API_ORIGIN=http://localhost:8084
CATEGORIES_API_ORIGIN=http://localhost:8085
ORDERS_API_ORIGIN=http://localhost:8086

# LEGADO: el catálogo ya no usa Supabase; se eliminan al retirar el paquete
# (docs/PLAN-CATALOGO.md, paso 8).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
