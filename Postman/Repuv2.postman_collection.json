      "type": "string"
    },
    {
      "key": "phone",
      "value": "+573100000000",
      "type": "string"
    },
    {
      "key": "role",
      "value": "COMPRADOR",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "systemParamKey",
      "value": "MAX_DELIVERY_RADIUS_KM",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "",
      "type": "string"
    },
    {
      "key": "addressName",
      "value": "Casa Postman",
      "type": "string"
    },
    {
      "key": "addressFull",
      "value": "Carrera 43A # 7-50, Apto 1201",
      "type": "string"
    },
    {
      "key": "addressCity",
      "value": "Medellin",
      "type": "string"
    },
    {
      "key": "addressPostalCode",
      "value": "050021",
      "type": "string"
    },
    {
      "key": "addressLatitude",
      "value": "6.2088",
