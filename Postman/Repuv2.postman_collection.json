  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Registro y autenticación",
      "description": "Ejecutar primero Registro y después Login. Login guarda accessToken y userId en las variables de la colección.",
      "item": [
        {
          "name": "Registro de usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\",\n  \"phone\": \"{{phone}}\",\n  \"profileAttributes\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{host}}{{basePath}}/api/auth/register",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registra un usuario. Roles válidos: COMPRADOR, DISTRIBUIDOR, DOMICILIARIO, ANALISTA y ADMIN."
          },
          "response": []
        },
        {
          "name": "Login - crea cookie y token móvil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.userId) pm.collectionVariables.set('userId', body.userId);",
                  "console.log('Sesión iniciada para userId:', body.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              },
              {
                "key": "X-Device-Info",
                "value": "Postman Desktop"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{host}}{{basePath}}/api/auth/login",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Crea una sesión opaca. La respuesta incluye accessToken para clientes móviles y Set-Cookie para clientes web."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Sesiones",
      "description": "Endpoints de consulta y revocación. Requieren la cookie de sesión o Authorization: Bearer {{accessToken}}.",
      "item": [
        {
          "name": "Listar sesiones activas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{host}}{{basePath}}/api/auth/sessions",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "auth",
                "sessions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout sesión actual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{host}}{{basePath}}/api/auth/logout",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revoca la sesión actual en PostgreSQL y Redis y expira la cookie."
          },
          "response": []
        },
        {
          "name": "Logout todas las sesiones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{host}}{{basePath}}/api/auth/logout-all",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "auth",
                "logout-all"
              ]
            },
            "description": "Revoca todas las sesiones activas del usuario actual."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Perfil (ms-users)",
      "description": "Perfil gestionado por ms-users. Requiere Login previo para guardar accessToken.",
      "item": [
        {
          "name": "Consultar perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{usersHost}}{{usersBasePath}}/api/users/profile",
              "host": [
                "{{usersHost}}{{usersBasePath}}"
              ],
              "path": [
                "api",
                "users",
                "profile"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Esteban David\",\n  \"lastName\": \"Velez\",\n  \"phone\": \"+573100000001\",\n  \"profileAttributes\": {\n    \"preferredLanguage\": \"es\",\n    \"updatedFrom\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{usersHost}}{{usersBasePath}}/api/users/profile",
              "host": [
                "{{usersHost}}{{usersBasePath}}"
              ],
              "path": [
                "api",
                "users",
                "profile"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Parámetros del sistema",
      "description": "El endpoint de creación debe ejecutarse con un usuario autorizado según las reglas de seguridad del entorno.",
      "item": [
        {
          "name": "Listar parámetros activos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{host}}{{basePath}}/api/system/parameters",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "system",
                "parameters"
              ]
            }
          },
          "response": []
        },
        {
              "name": "05 - Direcciones de usuario",
              "description": "CRUD de direcciones del usuario autenticado. Requiere ejecutar Login previamente para guardar accessToken.",
              "item": [
                {
                  "name": "Listar direcciones",
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "X-Request-ID",
                        "value": "{{requestId}}"
                      }
                    ],
                    "url": {
                      "raw": "{{usersHost}}{{usersBasePath}}/api/users/addresses",
                      "host": [
                        "{{usersHost}}{{usersBasePath}}"
                      ],
                      "path": [
                        "api",
                        "users",
                        "addresses"
                      ]
                    }
                  },
                  "response": []
                },
                {
                  "name": "Crear dirección principal",
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Direccion creada', function () {",
                          "    pm.response.to.have.status(201);",
                          "});",
                          "const body = pm.response.json();",
                          "if (body.id) pm.collectionVariables.set('addressId', body.id);",
                          "console.log('addressId guardado:', body.id);"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "X-Request-ID",
                        "value": "{{requestId}}"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"name\": \"{{addressName}}\",\n  \"fullAddress\": \"{{addressFull}}\",\n  \"city\": \"{{addressCity}}\",\n  \"postalCode\": \"{{addressPostalCode}}\",\n  \"isPrimary\": true,\n  \"deliveryNotes\": \"{{addressNotes}}\",\n  \"location\": {\n    \"latitude\": {{addressLatitude}},\n    \"longitude\": {{addressLongitude}}\n  }\n}"
                    },
                    "url": {
                      "raw": "{{usersHost}}{{usersBasePath}}/api/users/addresses",
                      "host": [
                        "{{usersHost}}{{usersBasePath}}"
                      ],
                      "path": [
                        "api",
                        "users",
                        "addresses"
                      ]
                    }
                  },
                  "response": []
                },
                {
                  "name": "Actualizar dirección",
                  "event": [
                    {
                      "listen": "prerequest",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "if (!pm.collectionVariables.get('addressId')) {",
                          "    console.warn('Ejecuta primero Crear direccion principal para obtener addressId.');",
                          "}"
                        ]
                      }
                    },
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Direccion actualizada', function () {",
                          "    pm.response.to.have.status(200);",
                          "});"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "method": "PATCH",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "X-Request-ID",
                        "value": "{{requestId}}"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"name\": \"{{addressName}} actualizada\",\n  \"fullAddress\": \"{{addressFull}}\",\n  \"city\": \"{{addressCity}}\",\n  \"postalCode\": \"{{addressPostalCode}}\",\n  \"isPrimary\": true,\n  \"deliveryNotes\": \"{{addressNotes}} - actualizada\",\n  \"location\": {\n    \"latitude\": {{addressLatitude}},\n    \"longitude\": {{addressLongitude}}\n  }\n}"
                    },
                    "url": {
                      "raw": "{{usersHost}}{{usersBasePath}}/api/users/addresses/{{addressId}}",
                      "host": [
                        "{{usersHost}}{{usersBasePath}}"
                      ],
                      "path": [
                        "api",
                        "users",
                        "addresses",
                        "{{addressId}}"
                      ]
                    }
                  },
                  "response": []
                },
                {
                  "name": "Eliminar dirección (soft delete)",
                  "event": [
                    {
                      "listen": "prerequest",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "if (!pm.collectionVariables.get('addressId')) {",
                          "    console.warn('Ejecuta primero Crear direccion principal para obtener addressId.');",
                          "}"
                        ]
                      }
                    },
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test('Direccion eliminada', function () {",
                          "    pm.response.to.have.status(204);",
                          "});",
                          "pm.collectionVariables.unset('addressId');"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "method": "DELETE",
                    "header": [
                      {
                        "key": "X-Request-ID",
                        "value": "{{requestId}}"
                      }
                    ],
                    "url": {
                      "raw": "{{usersHost}}{{usersBasePath}}/api/users/addresses/{{addressId}}",
                      "host": [
                        "{{usersHost}}{{usersBasePath}}"
                      ],
                      "path": [
                        "api",
                        "users",
                        "addresses",
                        "{{addressId}}"
                      ]
                    }
                  },
                  "response": []
                }
              ]
            },
        {
          "name": "Crear parámetro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{systemParamKey}}\",\n  \"configValue\": {\n    \"radiusKm\": 15,\n    \"fallbackToThirdPartyLogistics\": true\n  },\n  \"description\": \"Radio máximo de cobertura para asignación de repartidores directos\"\n}"
            },
            "url": {
              "raw": "{{host}}{{basePath}}/api/system/parameters",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "system",
                "parameters"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar parámetro por clave",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{host}}{{basePath}}/api/system/parameters/key/{{systemParamKey}}",
              "host": [
                "{{host}}{{basePath}}"
              ],
              "path": [
                "api",
                "system",
                "parameters",
                "key",
                "{{systemParamKey}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Recuperación de contraseña",
      "description": "Solicita un código por correo y actualiza la contraseña con el código recibido.",
      "item": [
        {
          "name": "Solicitar código",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{requestId}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{usersHost}}{{usersBasePath}}/api/users/password-recovery",
              "host": ["{{usersHost}}{{usersBasePath}}"],
              "path": ["api", "users", "password-recovery"]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar contraseña",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{requestId}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"000000\",\n  \"newPassword\": \"NuevaP@ss2026!\"\n}"
            },
            "url": {
              "raw": "{{usersHost}}{{usersBasePath}}/api/users/password-reset",
              "host": ["{{usersHost}}{{usersBasePath}}"],
              "path": ["api", "users", "password-reset"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "protocolProfileBehavior": {
    "disableBodyPruning": true
  }
}
